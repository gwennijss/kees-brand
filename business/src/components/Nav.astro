---
import BusinessLogo from '../../../src/components/BusinessLogo.astro';
import Logo from '../../../src/components/Logo.astro';
import { KEES_URL } from '../../../src/lib/sites';

const links = [
  { href: '#hoe', label: 'Hoe het werkt' },
  { href: '#regelt', label: 'Wat Kees regelt' },
  { href: '#contracten', label: 'Contracten' },
  { href: '#week', label: 'Een week' },
  { href: '#prijzen', label: 'Prijzen' },
];
---

<header class="nav" data-nav>
  <div class="nav__pil">
    <a href="/" class="nav__logo" aria-label="Business Kees, naar de homepage">
      <BusinessLogo variant="regel" />
    </a>

    <nav aria-label="Hoofdmenu" class="nav__menu">
      <ul class="nav__links">
        {
          links.map((l) => (
            <li>
              <a class="nav__link" href={l.href}>
                <span class="rol"><span>{l.label}</span></span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="#wachtlijst" class="nav__cta">
      <span class="rol"><span>Op de wachtlijst</span></span>
    </a>
  </div>

  <a href={KEES_URL} class="nav__thuis" aria-label="Kees voor thuis">
    <Logo />
    <span class="nav__thuis-label">voor thuis</span>
  </a>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const update = () => nav.classList.toggle('is-gescrold', window.scrollY > 12);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 14px var(--gutter) 0;
    pointer-events: none;
  }

  .nav__pil,
  .nav__thuis {
    display: flex;
    align-items: center;
    height: 54px;
    border-radius: 999px;
    background: var(--wit);
    box-shadow:
      0 0 0 1px var(--lijn),
      0 10px 30px -18px rgb(20 20 60 / 0.35);
    pointer-events: auto;
    transition:
      box-shadow 0.3s,
      transform 0.5s var(--uit);
  }

  .nav__pil {
    gap: 6px;
    padding: 7px 7px 7px 22px;
  }

  .is-gescrold .nav__pil,
  .is-gescrold .nav__thuis {
    box-shadow:
      0 0 0 1px var(--lijn),
      0 18px 40px -16px rgb(20 20 60 / 0.35);
  }

  .nav__logo {
    margin-right: 14px;
    text-decoration: none;
  }

  .nav__logo :global(.blogo) {
    font-size: 1.6rem;
  }

  .nav__links {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link,
  .nav__cta {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 15px;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s var(--zacht),
      color 0.25s var(--zacht);
  }

  .nav__link:hover {
    background: var(--nacht);
    color: var(--wit);
  }

  .nav__cta {
    margin-left: 6px;
    background: var(--primair);
    color: var(--wit);
    font-weight: 600;
  }

  .nav__cta:hover {
    background: var(--nacht);
  }

  .rol {
    display: inline-block;
    height: 1.3em;
    overflow: hidden;
    line-height: 1.3;
  }

  .rol > span {
    display: inline-block;
    text-shadow: 0 1.3em currentColor;
    transition: transform 0.45s var(--zacht);
  }

  .nav__link:hover .rol > span,
  .nav__cta:hover .rol > span {
    transform: translateY(-1.3em);
  }

  /* Losse knop rechtsboven terug naar Kees thuis */
  .nav__thuis {
    margin-left: 8px;
    gap: 10px;
    padding: 0 20px;
    text-decoration: none;
  }

  .nav__thuis:hover {
    transform: translateY(-2px);
  }

  .nav__thuis :global(.logo) {
    font-size: 1.6rem;
  }

  .nav__thuis-label {
    font-weight: 700;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--bordeaux) 60%, var(--wit));
  }

  @media (max-width: 1360px) {
    .nav__thuis-label {
      display: none;
    }
  }

  @media (max-width: 1100px) {
    .nav__links li:nth-child(4) {
      display: none;
    }
  }

  @media (max-width: 920px) {
    .nav__menu,
    .nav__thuis {
      display: none;
    }

    .nav__pil {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 520px) {
    .nav__pil {
      padding-left: 16px;
    }

    .nav__logo {
      margin-right: 0;
    }

    .nav__logo :global(.blogo) {
      font-size: 1.3rem;
    }

    .nav__cta {
      padding: 0 14px;
      font-size: 0.82rem;
    }
  }
</style>
