---
import BusinessLogo from '../../../src/components/BusinessLogo.astro';
import Logo from '../../../src/components/Logo.astro';
import { KEES_URL } from '../../../src/lib/sites';

const links = [
  { href: '#hoe', label: 'Hoe het werkt' },
  { href: '#regelt', label: 'Wat Kees regelt' },
  { href: '#contracten', label: 'Contracten' },
  { href: '#week', label: 'Een week' },
  { href: '#prijzen', label: 'Prijzen' },
];
---

<header class="nav" data-nav>
  <div class="nav__waas" data-nav-waas aria-hidden="true"></div>

  <div class="nav__pil">
    <a href="/" class="nav__logo" aria-label="Business Kees, naar de homepage">
      <BusinessLogo variant="regel" />
    </a>

    <nav aria-label="Hoofdmenu" class="nav__menu">
      <ul class="nav__links">
        {
          links.map((l) => (
            <li>
              <a class="nav__link" href={l.href}>
                <span class="rol"><span>{l.label}</span></span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="#wachtlijst" class="nav__cta">
      <span class="rol"><span><span class="nav__cta-lang">Op de wachtlijst</span><span class="nav__cta-kort">Wachtlijst</span></span></span>
    </a>

    <button
      type="button"
      class="nav__knop"
      aria-expanded="false"
      aria-controls="nav-uitklap"
      aria-label="Menu openen"
      data-nav-knop
    >
      <span class="nav__streep" aria-hidden="true"></span>
      <span class="nav__streep" aria-hidden="true"></span>
    </button>
  </div>

  <a href={KEES_URL} class="nav__thuis" aria-label="Kees voor thuis">
    <Logo />
    <span class="nav__thuis-label">voor thuis</span>
  </a>

  <!-- Mobiel: uitklapmenu met de links en de weg naar Kees voor thuis -->
  <div class="nav__uitklap" id="nav-uitklap" data-nav-uitklap>
    <nav aria-label="Menu">
      <ul class="nav__lijst">
        {
          links.map((l, i) => (
            <li style={`--n:${i}`}>
              <a class="nav__item" href={l.href} data-nav-item>
                {l.label}
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={KEES_URL} class="nav__ook" style={`--n:${links.length}`}>
      <span class="nav__ook-merk"><Logo /><span>voor thuis</span></span>
      <span class="nav__ook-tekst">De gezinsassistent in WhatsApp</span>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" /></svg>
    </a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const update = () => nav.classList.toggle('is-gescrold', window.scrollY > 12);
  update();
  window.addEventListener('scroll', update, { passive: true });

  // Mobiel menu
  const knop = nav.querySelector<HTMLButtonElement>('[data-nav-knop]')!;
  const uitklap = nav.querySelector<HTMLElement>('[data-nav-uitklap]')!;
  const waas = nav.querySelector<HTMLElement>('[data-nav-waas]')!;
  type Lenis = { stop: () => void; start: () => void };
  const lenis = () => (window as unknown as { lenis?: Lenis }).lenis;

  function zet(open: boolean, focusTerug = false) {
    nav.classList.toggle('is-open', open);
    knop.setAttribute('aria-expanded', String(open));
    knop.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
    document.documentElement.classList.toggle('nav-open', open);
    if (open) lenis()?.stop();
    else lenis()?.start();
    if (focusTerug) knop.focus();
  }

  knop.addEventListener('click', () => zet(!nav.classList.contains('is-open')));
  waas.addEventListener('click', () => zet(false));
  // Sluiten vóór Lenis naar het anker scrolt
  uitklap.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => zet(false)));
  nav.querySelector('.nav__cta')!.addEventListener('click', () => nav.classList.contains('is-open') && zet(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('is-open')) zet(false, true);
  });
  matchMedia('(min-width: 921px)').addEventListener('change', (e) => e.matches && zet(false));
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 14px var(--gutter) 0;
    pointer-events: none;
  }

  .nav__pil,
  .nav__thuis {
    display: flex;
    align-items: center;
    height: 54px;
    border-radius: 999px;
    background: var(--wit);
    box-shadow:
      0 0 0 1px var(--lijn),
      0 10px 30px -18px rgb(20 20 60 / 0.35);
    pointer-events: auto;
    transition:
      box-shadow 0.3s,
      transform 0.5s var(--uit);
  }

  .nav__pil {
    gap: 6px;
    padding: 7px 7px 7px 22px;
  }

  .is-gescrold .nav__pil,
  .is-gescrold .nav__thuis {
    box-shadow:
      0 0 0 1px var(--lijn),
      0 18px 40px -16px rgb(20 20 60 / 0.35);
  }

  .nav__logo {
    margin-right: 14px;
    text-decoration: none;
  }

  .nav__logo :global(.blogo) {
    font-size: 1.6rem;
  }

  .nav__links {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link,
  .nav__cta {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 15px;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s var(--zacht),
      color 0.25s var(--zacht);
  }

  .nav__link:hover {
    background: var(--nacht);
    color: var(--wit);
  }

  .nav__cta {
    margin-left: 6px;
    background: var(--primair);
    color: var(--wit);
    font-weight: 600;
  }

  .nav__cta:hover {
    background: var(--nacht);
  }

  .rol {
    display: inline-block;
    height: 1.3em;
    overflow: hidden;
    line-height: 1.3;
  }

  .rol > span {
    display: inline-block;
    text-shadow: 0 1.3em currentColor;
    transition: transform 0.45s var(--zacht);
  }

  .nav__link:hover .rol > span,
  .nav__cta:hover .rol > span {
    transform: translateY(-1.3em);
  }

  /* Losse knop rechtsboven terug naar Kees thuis */
  .nav__thuis {
    margin-left: 8px;
    gap: 10px;
    padding: 0 20px;
    text-decoration: none;
  }

  .nav__thuis:hover {
    transform: translateY(-2px);
  }

  .nav__thuis :global(.logo) {
    font-size: 1.6rem;
  }

  .nav__thuis-label {
    font-weight: 700;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--bordeaux) 60%, var(--wit));
  }

  @media (max-width: 1360px) {
    .nav__thuis-label {
      display: none;
    }
  }

  @media (max-width: 1100px) {
    .nav__links li:nth-child(4) {
      display: none;
    }
  }

  /* ---------- Mobiel menu (alleen onder 920px zichtbaar) ---------- */
  .nav__knop,
  .nav__uitklap,
  .nav__waas,
  .nav__cta-kort {
    display: none;
  }

  @media (max-width: 920px) {
    .nav__menu,
    .nav__thuis {
      display: none;
    }

    .nav__pil {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 56px;
      gap: 6px;
      padding: 6px 6px 6px 20px;
    }

    .nav__logo {
      margin-right: auto;
    }

    .nav__cta {
      height: 44px;
      margin-left: 0;
    }

    .nav__knop {
      position: relative;
      display: grid;
      place-items: center;
      flex: none;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--hemel-zacht);
      color: var(--nacht);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition:
        background-color 0.3s var(--zacht),
        color 0.3s var(--zacht);
    }

    .nav__streep {
      position: absolute;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      translate: 0 -3.5px;
      transition:
        translate 0.35s var(--uit),
        rotate 0.45s var(--veer);
    }

    .nav__streep + .nav__streep {
      translate: 0 3.5px;
    }

    .is-open .nav__knop {
      background: var(--nacht);
      color: var(--wit);
    }

    .is-open .nav__streep {
      translate: 0 0;
      rotate: 45deg;
    }

    .is-open .nav__streep + .nav__streep {
      rotate: -45deg;
    }

    /* Zachte waas over de pagina zolang het menu open is */
    .nav__waas {
      position: fixed;
      inset: 0;
      display: block;
      background: rgb(20 20 60 / 0.22);
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.35s var(--zacht),
        visibility 0s 0.35s;
    }

    .is-open .nav__waas {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.35s var(--zacht);
    }

    /* Het uitklapmenu: een witte kaart onder de pil */
    .nav__uitklap {
      position: absolute;
      z-index: 1;
      top: calc(14px + 56px + 8px);
      left: var(--gutter);
      right: var(--gutter);
      display: grid;
      gap: 6px;
      max-height: calc(100svh - 96px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 8px;
      border-radius: 28px;
      background: var(--wit);
      box-shadow:
        0 0 0 1px var(--lijn),
        0 30px 60px -24px rgb(20 20 60 / 0.4);
      pointer-events: auto;
      transform-origin: 100% 0;
      opacity: 0;
      visibility: hidden;
      translate: 0 -10px;
      scale: 0.97;
      transition:
        opacity 0.25s var(--zacht),
        translate 0.45s var(--uit),
        scale 0.45s var(--uit),
        visibility 0s 0.45s;
    }

    .is-open .nav__uitklap {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
      scale: 1;
      transition:
        opacity 0.25s var(--zacht),
        translate 0.5s var(--uit),
        scale 0.5s var(--uit);
    }

    .nav__lijst {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .nav__lijst li,
    .nav__ook {
      opacity: 0;
      translate: 0 8px;
      transition:
        opacity 0.3s var(--zacht),
        translate 0.5s var(--uit);
    }

    .is-open .nav__lijst li,
    .is-open .nav__ook {
      opacity: 1;
      translate: 0 0;
      transition-delay: calc(var(--n) * 35ms + 60ms);
    }

    .nav__lijst li + li .nav__item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 18px;
      right: 18px;
      height: 1px;
      background: var(--lijn);
    }

    .nav__item {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 56px;
      padding: 0 18px;
      border-radius: 18px;
      color: var(--nacht);
      font-family: var(--font-kop);
      font-weight: var(--kop-gewicht);
      font-variation-settings: var(--kop-variatie);
      font-size: 1.3rem;
      letter-spacing: -0.03em;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
      transition: background-color 0.25s var(--zacht);
    }

    .nav__item svg {
      flex: none;
      width: 18px;
      color: var(--primair);
      transition: translate 0.35s var(--uit);
    }

    .nav__item:hover,
    .nav__item:active {
      background: var(--hemel-licht);
    }

    .nav__item:hover::before,
    .nav__item:active::before,
    li:has(.nav__item:hover) + li .nav__item::before,
    li:has(.nav__item:active) + li .nav__item::before {
      opacity: 0;
    }

    .nav__item:hover svg {
      translate: 3px 0;
    }

    /* Naar Kees voor thuis: in de warme Kees-achtergrond */
    .nav__ook {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 4px 12px;
      padding: 16px 16px 16px 18px;
      border-radius: 20px;
      background: var(--achtergrond);
      color: var(--bordeaux);
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }

    .nav__ook-merk {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .nav__ook-merk :global(.logo) {
      font-size: 1.6rem;
    }

    .nav__ook-merk > span:last-child {
      font-weight: 700;
      font-size: 0.85rem;
      color: color-mix(in srgb, var(--bordeaux) 60%, var(--wit));
    }

    .nav__ook-tekst {
      grid-column: 1;
      font-size: 0.88rem;
      color: color-mix(in srgb, var(--bordeaux) 70%, var(--achtergrond));
    }

    .nav__ook svg {
      grid-column: 2;
      grid-row: 1 / span 2;
      box-sizing: content-box;
      width: 16px;
      padding: 12px;
      border-radius: 50%;
      background: var(--wit);
      color: var(--bordeaux);
      transition: rotate 0.4s var(--veer);
    }

    .nav__ook:hover svg {
      rotate: 45deg;
    }

    :global(html.nav-open) {
      overflow: hidden;
    }
  }

  @media (max-width: 520px) {
    .nav__pil {
      padding-left: 16px;
    }

    .nav__logo :global(.blogo) {
      font-size: 1.3rem;
    }

    .nav__cta {
      padding: 0 16px;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 400px) {
    .nav__cta-lang {
      display: none;
    }

    .nav__cta-kort {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__uitklap,
    .nav__lijst li,
    .nav__ook {
      translate: none !important;
      scale: none !important;
    }
  }
</style>
