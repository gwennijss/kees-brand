---
import Bloem from '../../../src/components/Bloem.astro';
import Sticker from '../../../src/components/Sticker.astro';

// Contractbeheer: links de belofte, rechts een rustig overzicht met zes contracten.
// Peildatum: begin oktober 2026.
type Toon = 'let-op' | 'info' | 'rustig' | 'prive';

const contracten: { naam: string; einde: string; kosten: string; voortgang: number; status: string; toon: Toon }[] = [
  { naam: 'Kantoorpand', einde: 'tot 31 dec 2027', kosten: '€4.250', voortgang: 0.75, status: 'Loopt', toon: 'rustig' },
  { naam: 'Bestelbus', einde: 'tot 7 dec 2026', kosten: '€612', voortgang: 0.96, status: 'Over 2 maanden', toon: 'let-op' },
  { naam: 'Internet glasvezel', einde: 'tot 1 mrt 2027', kosten: '€89', voortgang: 0.8, status: '2 goedkopere opties', toon: 'info' },
  { naam: 'Kantoorsoftware', einde: 'per maand', kosten: '€144', voortgang: 0.22, status: '3 ongebruikt', toon: 'info' },
  { naam: 'Bedrijfsaansprakelijkheid', einde: 'tot 1 jan 2027', kosten: '€96', voortgang: 0.77, status: 'Opzeggen?', toon: 'let-op' },
  { naam: 'Tijdelijk contract', einde: 'tot 31 jan 2027', kosten: '••••', voortgang: 0.68, status: 'Alleen bevoegden', toon: 'prive' },
];

const SLOT =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9.5" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
---

<section class="sectie sectie--nacht ctr" id="contracten" data-ctr>
  <Bloem class="bloem ctr__bloem" kleur="var(--indigo)" lobes={12} amp={0.08} />

  <div class="container ctr__grid">
    <div class="ctr__tekst">
      <h2 class="kop-l" data-reveal>Nooit meer een contract dat stilzwijgend verlengt.</h2>
      <p class="lead" data-reveal style="--d:1">
        Stuur Kees een contract of polis. Kees zet looptijd, opzegtermijn en kosten in één overzicht en seint je ruim voor
        het aflopen. Ook als de collega die het regelde weg is, vind je alles terug.
      </p>
    </div>

    <div class="ctr-podium" data-reveal style="--d:2">
      <Sticker class="ctr__sticker" lobes={14}>Bespaar<br />€432<br />per jaar</Sticker>

      <div class="ctr-paneel" role="table" aria-label="Contractoverzicht">
        <div class="ctr-paneel__kop">
          <p class="ctr-paneel__titel">
            <span class="ctr-paneel__icoon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3.5" width="16" height="17" rx="2.5"></rect><path d="M8 8.5h8M8 12h8M8 15.5h5"></path></svg>
            </span>
            <span><b>Contracten</b><small>Kantoor Amsterdam</small></span>
          </p>
          <p class="ctr-paneel__totaal"><small>Per maand</small><b>€5.191</b></p>
        </div>

        <ul class="ctr-lijst">
          {
            contracten.map((c, i) => (
              <li class:list={['ctr-rij', `ctr-rij--${c.toon}`]} role="row" style={`--i:${i}`}>
                <span class="ctr-rij__naam" role="cell">
                  <b>{c.naam}</b>
                  <small>{c.einde}</small>
                </span>
                <span class="ctr-rij__kosten" role="cell">{c.kosten}</span>
                <span class="ctr-status" role="cell">
                  {c.toon === 'prive' && <Fragment set:html={SLOT} />}
                  {c.status}
                </span>
                <span class="ctr-balk" aria-hidden="true">
                  <i style={`--w:${c.voortgang}`} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ctr {
    padding-block: clamp(64px, 6.5vw, 96px);
    overflow: clip;
  }

  .ctr :global(.ctr__bloem) {
    right: -14%;
    top: -22%;
    width: min(62vw, 760px);
    aspect-ratio: 1;
    opacity: 0.9;
    --duur: 110s;
  }

  .ctr__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .ctr__tekst {
    display: grid;
    gap: 20px;
  }

  /* ---------- Paneel ---------- */
  .ctr-podium {
    position: relative;
    min-width: 0;
  }

  .ctr-podium[data-reveal] {
    transform-origin: 30% 100%;
    transition:
      opacity 1s var(--uit),
      transform 1.3s var(--veer),
      filter 1s var(--uit);
    transition-delay: calc(var(--d, 0) * 110ms);
  }

  .ctr-podium[data-reveal]:not(.is-zichtbaar) {
    transform: translateY(80px) rotate(-4deg);
  }

  .ctr-podium :global(.ctr__sticker) {
    position: absolute;
    z-index: 2;
    top: -46px;
    right: -34px;
    width: 128px;
    font-size: 1.05rem;
    rotate: 12deg;
    filter: drop-shadow(0 16px 22px rgb(0 0 20 / 0.35));
  }

  .ctr-podium.is-zichtbaar :global(.ctr__sticker) {
    animation: ctr-sticker 0.8s var(--veer) 1.1s both;
  }

  @keyframes ctr-sticker {
    from {
      opacity: 0;
      scale: 0.3;
      rotate: -30deg;
    }
  }

  .ctr-paneel {
    --lijn: color-mix(in srgb, var(--nacht) 10%, transparent);
    padding: 8px 8px 10px;
    border-radius: var(--radius-l);
    background: var(--wit);
    color: var(--nacht);
    box-shadow: 0 50px 80px -40px rgb(0 0 20 / 0.7);
  }

  .ctr-paneel__kop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 104px 16px 18px;
    border-bottom: 1px solid var(--lijn);
  }

  .ctr-paneel__titel {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ctr-paneel__titel > span:last-child {
    display: grid;
    line-height: 1.25;
  }

  .ctr-paneel__titel b {
    font-family: var(--font-kop);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .ctr-paneel__titel small,
  .ctr-paneel__totaal small {
    font-size: 0.8rem;
    color: var(--ink-stil);
  }

  .ctr-paneel__icoon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--hemel-zacht);
    color: var(--indigo);
  }

  .ctr-paneel__icoon svg {
    width: 20px;
  }

  .ctr-paneel__totaal {
    display: grid;
    justify-items: end;
    line-height: 1.2;
  }

  .ctr-paneel__totaal b {
    font-family: var(--font-kop);
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  /* ---------- Rijen ---------- */
  .ctr-lijst {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ctr-rij {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas:
      'naam kosten status'
      'balk balk balk';
    align-items: center;
    column-gap: 18px;
    row-gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--lijn);
  }

  .ctr-rij:last-child {
    border-bottom: 0;
  }

  .ctr-rij__naam {
    grid-area: naam;
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
  }

  .ctr-rij__naam b {
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ctr-rij__naam small {
    font-size: 0.8rem;
    color: var(--ink-stil);
    white-space: nowrap;
  }

  .ctr-rij__kosten {
    grid-area: kosten;
    font-weight: 700;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  .ctr-balk {
    grid-area: balk;
    display: block;
    height: 5px;
    border-radius: 999px;
    background: var(--licht-diep);
    overflow: hidden;
  }

  .ctr-balk i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--hemel);
    transform-origin: left;
    transform: scaleX(0);
  }

  .is-zichtbaar .ctr-balk i {
    transform: scaleX(var(--w));
    transition: transform 1.4s var(--uit);
    transition-delay: calc(var(--i, 0) * 90ms + 500ms);
  }

  .ctr-rij--let-op .ctr-balk i {
    background: var(--indigo);
  }

  .ctr-rij--info .ctr-balk i {
    background: color-mix(in srgb, var(--indigo) 55%, var(--hemel));
  }

  .ctr-rij--prive .ctr-balk i {
    background: repeating-linear-gradient(135deg, var(--indigo-zacht) 0 4px, var(--hemel) 4px 8px);
  }

  .ctr-status {
    grid-area: status;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 138px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: inset 0 0 0 1px var(--lijn);
    color: var(--ink-stil);
  }

  .ctr-status :global(svg) {
    width: 11px;
  }

  /* Klein tomaat-accent: alleen waar actie nodig is */
  .ctr-rij--let-op .ctr-status {
    background: var(--tomaat-zacht);
    color: #c2410c;
    box-shadow: none;
  }

  .ctr-rij--info .ctr-status {
    background: var(--hemel-zacht);
    color: var(--indigo);
    box-shadow: none;
  }

  .ctr-rij--prive .ctr-status {
    background: var(--indigo-zacht);
    color: var(--nacht);
    box-shadow: none;
  }

  .ctr-rij--prive .ctr-rij__kosten {
    letter-spacing: 0.08em;
  }

  /* ---------- Responsief ---------- */
  @media (max-width: 1000px) {
    .ctr__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .ctr__grid {
      gap: 64px;
    }

    .ctr-paneel__kop {
      padding: 14px 14px 14px 12px;
    }

    .ctr-paneel__titel {
      gap: 10px;
    }

    /* Per contract drie compacte regels: naam en kosten, einddatum en status, de balk */
    .ctr-rij {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'naam naam kosten'
        'einde status status'
        'balk balk balk';
      column-gap: 10px;
      row-gap: 6px;
      padding: 12px 14px 14px 12px;
    }

    .ctr-rij__naam {
      display: contents;
    }

    .ctr-rij__naam b {
      grid-area: naam;
      font-size: 1rem;
    }

    .ctr-rij__naam small {
      grid-area: einde;
      font-size: 0.85rem;
    }

    .ctr-rij__kosten {
      font-size: 1rem;
    }

    .ctr-balk {
      margin-top: 4px;
    }

    .ctr-status {
      justify-self: end;
      min-width: 0;
      padding: 3px 9px;
    }

    .ctr-podium :global(.ctr__sticker) {
      width: 84px;
      font-size: 0.74rem;
      right: -6px;
      top: -72px;
    }
  }
</style>
