---
import Bloem from '../../../src/components/Bloem.astro';
import Sticker from '../../../src/components/Sticker.astro';

// FAQ: de vier vragen van de site, aangevuld met vier die het contextdocument beantwoordt.
const vragen = [
  {
    v: 'Moeten we een nieuwe app installeren?',
    a: 'Nee. Kees werkt in WhatsApp en koppelt met de agenda en systemen die jullie al gebruiken, zoals monday.',
  },
  {
    v: 'Kan Kees zomaar dingen bestellen?',
    a: 'Nee. Kees doet voorstellen binnen jullie budget en bestelt pas na akkoord van de verantwoordelijke.',
  },
  {
    v: 'Hoe houdt Kees zich aan ons budget?',
    a: 'Jullie stellen een vast budget in per maand en per onderdeel. Kees blijft daarbinnen en noemt bij elk voorstel wat het kost en uit welk budget het komt, bijvoorbeeld €32 uit het kantoorbudget.',
  },
  {
    v: 'Werkt het ook met een office manager?',
    a: 'Juist. Kees neemt het saaie werk over, zodat de office manager tijd heeft voor de mensen.',
  },
  {
    v: 'Waar blijven onze gegevens?',
    a: 'Gegevens worden zo veel mogelijk in Europa verwerkt en nooit verkocht. Werknemerscontracten en het aandeelhoudersregister zijn alleen zichtbaar voor wie dat mag zien. Mail koppelen zet je per collega aan of uit.',
  },
  {
    v: 'Wat zien we als collega’s Kees thuis gebruiken?',
    a: 'Alleen hoeveel collega’s Kees thuis gebruiken, nooit wat erin staat. Collega’s zien van elkaars privé-agenda alleen dat iemand bezet is. Wie vertrekt, houdt Kees thuis.',
  },
  {
    v: 'Wat kost Business Kees?',
    a: 'Vanaf €99 per maand voor teams tot 10 mensen, €249 tot 50 mensen en €449 tot 100 mensen. De eerste 30 dagen zijn gratis en je zegt maandelijks op. De eerste 50 bedrijven krijgen het eerste jaar de helft korting.',
  },
  {
    v: 'Wanneer kunnen we beginnen?',
    a: 'Business Kees komt na Kees thuis. Nu loopt een kleine pilot. Zet je op de wachtlijst, dan hoor je het als eerste.',
  },
];
---

<section class="sectie sectie--wit faq" id="vragen" data-faq>
  <div class="container faq__grid">
    <div class="faq__links">
      <div class="sectie-kop" data-reveal>
        <h2 class="kop-l">Veelgestelde vragen</h2>
        <p class="lead">Alles wat teams ons vragen voordat ze Kees in de groep zetten. Staat je vraag er niet bij? <a class="faq__mail" href="mailto:hallo@example.com">Mail ons gerust.</a></p>
      </div>

    </div>

    <div class="faq__lijst">
      {
        vragen.map((q, i) => (
          <details class="faq__item" name="faq-business" open={i === 0} data-reveal style={`--d:${Math.min(i, 5)}`}>
            <summary>
              <span class="faq__nr">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq__vraag">{q.v}</span>
              <span class="faq__plus" aria-hidden="true" />
            </summary>
            <div class="faq__antwoord">
              <p>{q.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__mail {
    color: var(--primair);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  .faq {
    padding-block: clamp(64px, 7vw, 96px);
    interpolate-size: allow-keywords;
  }

  .faq__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .faq__links {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 32px;
  }

  .faq .sectie-kop {
    margin: 0;
    gap: 16px;
  }

  /* ---------- Contactkaart: vol botergeel vlak met bloem en sticker ---------- */
  .faq__contact-plek {
    max-width: 400px;
  }

  .faq__contact {
    position: relative;
    display: grid;
    gap: 10px;
    padding: 30px 30px 32px;
    border-radius: var(--radius-l);
    background: var(--boter);
    color: var(--nacht);
    box-shadow: 0 34px 50px -34px rgb(20 20 60 / 0.45);
    rotate: -2deg;
    isolation: isolate;
    transition: rotate 0.7s var(--veer);
  }

  .faq__contact:hover {
    rotate: 0deg;
  }

  .faq__contact-achter {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    overflow: hidden;
  }

  .faq__contact-achter :global(.faq__contact-bloem) {
    position: absolute;
    right: -30%;
    bottom: -52%;
    width: 78%;
    max-width: none;
    animation: draai 70s linear infinite;
  }

  .faq__contact :global(.faq__sticker) {
    position: absolute;
    top: -22px;
    right: -16px;
    width: 62px;
    font-size: 1.6rem;
    padding-bottom: 4px;
    rotate: 12deg;
    filter: drop-shadow(0 8px 12px rgb(20 20 60 / 0.25));
    transition: rotate 0.6s var(--veer);
  }

  .faq__contact:hover :global(.faq__sticker) {
    rotate: -8deg;
  }

  .faq__contact-titel {
    max-width: 9em;
    font-family: var(--font-kop);
    font-weight: var(--kop-gewicht);
    font-size: 1.85rem;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .faq__contact-sub {
    max-width: 17em;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-zacht);
  }

  .faq__contact-acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 12px;
  }

  .faq__link {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--nacht);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    text-decoration-color: var(--indigo);
    transition: text-decoration-color 0.3s;
  }

  .faq__link:hover {
    text-decoration-color: currentColor;
  }

  /* ---------- Accordeon ---------- */
  .faq__lijst {
    display: grid;
    border-top: 1px solid var(--lijn);
  }

  .faq__item {
    position: relative;
    border-bottom: 1px solid var(--lijn);
  }

  .faq__item::before {
    content: '';
    position: absolute;
    inset: 4px -14px;
    z-index: 0;
    border-radius: var(--radius-m);
    background: var(--hemel-licht);
    opacity: 0;
    scale: 0.98;
    transition:
      opacity 0.4s var(--uit),
      scale 0.5s var(--uit);
  }

  .faq__item[open]::before {
    opacity: 1;
    scale: 1;
  }

  .faq__item:has(summary:hover):not([open])::before {
    opacity: 0.55;
    scale: 1;
  }

  summary {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 15px 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: none;
  }

  summary:focus-visible .faq__vraag {
    text-decoration: underline;
    text-decoration-color: var(--hemel);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .faq__nr {
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    color: var(--ink-stil);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s;
  }

  .faq__item[open] .faq__nr {
    color: var(--primair);
  }

  .faq__vraag {
    font-weight: 700;
    font-size: 1.04rem;
    line-height: 1.3;
  }

  .faq__plus {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--hemel-zacht);
    transition:
      rotate 0.5s var(--veer),
      background-color 0.3s;
  }

  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--primair);
    transition: background-color 0.3s;
  }

  .faq__plus::after {
    rotate: 90deg;
  }

  summary:hover .faq__plus {
    background: var(--hemel);
  }

  .faq__item[open] .faq__plus {
    rotate: 135deg;
    background: var(--nacht);
  }

  .faq__item[open] .faq__plus::before,
  .faq__item[open] .faq__plus::after {
    background: var(--wit);
  }

  /* Zacht openschuiven (waar de browser ::details-content kent) */
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.5s var(--uit),
      content-visibility 0.5s allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  .faq__antwoord {
    position: relative;
    z-index: 1;
    padding: 0 52px 18px;
    color: var(--ink-zacht);
    font-size: 0.97rem;
    line-height: 1.55;
    max-width: 640px;
  }

  .faq__item[open] .faq__antwoord p {
    animation: faq-in 0.5s var(--uit) both;
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .faq__links {
      display: contents;
    }

    .faq__contact-plek {
      order: 2;
      margin-top: 16px;
    }
  }

  @media (max-width: 560px) {
    summary {
      grid-template-columns: 30px 1fr auto;
      gap: 8px;
    }

    .faq__vraag {
      font-size: 0.98rem;
    }

    .faq__antwoord {
      padding: 0 0 18px 38px;
    }

    .faq__item::before {
      inset: 4px -10px;
    }

    .faq__contact {
      padding: 26px 24px 28px;
    }

    .faq__contact :global(.faq__sticker) {
      right: -6px;
    }
  }
</style>
