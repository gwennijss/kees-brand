---
import Sticker from '../../../src/components/Sticker.astro';
import Bloem from '../../../src/components/Bloem.astro';

const principes = [
  { titel: 'Jij beslist', tekst: 'Kees bestelt en boekt niets zonder akkoord van de verantwoordelijke.' },
  { titel: 'Wie mag wat', tekst: 'Per collega stel je in wat Kees voor hem of haar mag regelen.' },
  { titel: 'Een vast budget', tekst: 'Kees blijft binnen het budget per maand en per onderdeel.' },
  { titel: 'Data in Europa', tekst: 'Gegevens worden zo veel mogelijk in Europa verwerkt en nooit verkocht.' },
];

const rechten = [
  { id: 'bestellen', label: 'Bestellen', aan: 'kan Kees nu ook laten bestellen', uit: 'kan Kees niet meer laten bestellen' },
  { id: 'boeken', label: 'Boeken', aan: 'kan Kees nu ook laten boeken', uit: 'kan Kees niet meer laten boeken' },
  { id: 'mail', label: 'Mail', aan: 'krijgt nu ook hulp van Kees met mail', uit: 'krijgt geen hulp meer van Kees met mail' },
];

const collegas = [
  { naam: 'Sanne', rol: 'Office manager', kleur: 'var(--boter)', rechten: [true, true, true] },
  { naam: 'Mark', rol: 'Accountmanager', kleur: 'var(--hemel-zacht)', rechten: [true, false, true] },
  { naam: 'Joost', rol: 'Projectleider', kleur: 'var(--indigo-zacht)', rechten: [false, true, true] },
  { naam: 'Lisa', rol: 'Nieuw sinds maandag', kleur: 'var(--hemel-licht)', rechten: [false, false, false] },
];

const budgetten = [
  { naam: 'Kantoorbudget', gebruikt: 412, totaal: 600 },
  { naam: 'Borrels en uitjes', gebruikt: 180, totaal: 250 },
  { naam: 'Cadeaus', gebruikt: 64, totaal: 150 },
];

const euro = (n: number) => `€${n}`;
---

<section class="sectie sectie--nacht vg" id="veilig" data-veilig>
  <div class="container vg__grid">
    <div class="vg__tekst">
      <div class="vg__kop" data-reveal>
        <h2 class="kop-l">Kees doet veel. Binnen jullie grenzen.</h2>
        <p class="lead">
          Jullie stellen de regels in en Kees houdt zich eraan. Pas na akkoord wordt er besteld of geboekt.
        </p>
      </div>

      <ol class="vg__principes" role="list">
        {
          principes.map((p, i) => (
            <li data-reveal style={`--d:${i + 1}`}>
              <span class="vg__nummer">{String(i + 1).padStart(2, '0')}</span>
              <b>{p.titel}</b>
              <p>{p.tekst}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="vg__rechts">
    <div class="vg__vorm" data-reveal style="--d:1" aria-hidden="true">
      <Bloem class="vg__bloem" kleur="var(--hemel)" lobes={12} amp={0.07} />
    </div>

    <div class="vg-ui" data-reveal style="--d:2" data-vg-ui>
      <header class="vg-ui__kop">
        <Sticker class="vg-ui__avatar" lobes={10}>k</Sticker>
        <span class="vg-ui__titel">
          <b>Instellingen</b>
          <span>Kantoor · 12 collega’s</span>
        </span>
        <span class="vg-ui__eu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5.5c0 4.3-3 7.7-7 9.5-4-1.8-7-5.2-7-9.5V6z"></path><path d="M9 12l2 2 4-4"></path></svg>
          Data in Europa
        </span>
      </header>

      <div class="vg-ui__akkoord">
        <span class="vg-ui__slot" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2.5"></rect><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"></path></svg>
        </span>
        <span class="vg-ui__akkoord-tekst">
          <b>Altijd eerst akkoord</b>
          <span>Bestellingen en boekingen gaan langs Sanne</span>
        </span>
        <span class="vg-schakel vg-schakel--vast" aria-hidden="true"><span></span></span>
      </div>

      <div class="vg-ui__blok">
        <p class="vg-ui__label" id="vg-wie">Wie mag wat</p>
        <table class="vg-tabel" aria-labelledby="vg-wie">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Collega</span></th>
              {rechten.map((r) => <th scope="col">{r.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              collegas.map((c) => (
                <tr>
                  <th scope="row">
                    <span class="vg-persoon">
                      <span class="vg-persoon__init" style={`background:${c.kleur}`} aria-hidden="true">
                        {c.naam[0]}
                      </span>
                      <span class="vg-persoon__tekst">
                        <b>{c.naam}</b>
                        <span>{c.rol}</span>
                      </span>
                    </span>
                  </th>
                  {rechten.map((r, j) => (
                    <td>
                      <button
                        class="vg-schakel"
                        type="button"
                        role="switch"
                        aria-checked={String(c.rechten[j])}
                        aria-label={`${r.label} voor ${c.naam}`}
                        data-naam={c.naam}
                        data-aan={r.aan}
                        data-uit={r.uit}
                      >
                        <span />
                      </button>
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="vg-melding" role="status" aria-live="polite" data-melding>
          <span class="vg-melding__icoon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8.4l2.6 2.6L12 5.4"></path></svg>
          </span>
          <span data-melding-tekst>Tik op een schakelaar om het aan te passen.</span>
        </p>
      </div>

      <div class="vg-ui__blok">
        <p class="vg-ui__label">Budget oktober</p>
        <ul class="vg-budget" role="list">
          {
            budgetten.map((b, i) => (
              <li style={`--p:${b.gebruikt / b.totaal};--i:${i}`}>
                <span class="vg-budget__naam">
                  {b.naam}
                  <span class="vg-budget__over">{euro(b.totaal - b.gebruikt)} over</span>
                </span>
                <span class="vg-budget__bedrag">
                  <b>{euro(b.gebruikt)}</b> van {euro(b.totaal)}
                </span>
                <span class="vg-budget__balk" aria-hidden="true">
                  <span />
                </span>
              </li>
            ))
          }
        </ul>
      </div>

    </div>
    </div>
  </div>
</section>

<script>
  const vg = document.querySelector<HTMLElement>('[data-veilig]')!;
  const ui = vg.querySelector<HTMLElement>('[data-vg-ui]')!;
  const melding = vg.querySelector<HTMLElement>('[data-melding]')!;
  const meldingTekst = vg.querySelector<HTMLElement>('[data-melding-tekst]')!;

  function meld(tekst: string) {
    meldingTekst.textContent = tekst;
    melding.classList.remove('is-nieuw');
    void melding.offsetWidth;
    melding.classList.add('is-nieuw', 'is-gewijzigd');
  }

  vg.querySelectorAll<HTMLButtonElement>('.vg-schakel[role="switch"]').forEach((knop) => {
    knop.addEventListener('click', () => {
      const aan = knop.getAttribute('aria-checked') !== 'true';
      knop.setAttribute('aria-checked', String(aan));
      knop.closest('tr')?.classList.remove('is-gewijzigd');
      void (knop.closest('tr') as HTMLElement | null)?.offsetWidth;
      knop.closest('tr')?.classList.add('is-gewijzigd');
      meld(`${knop.dataset.naam} ${aan ? knop.dataset.aan : knop.dataset.uit}.`);
    });
  });

  // Budgetmeters lopen vol zodra de kaart in beeld komt
  new IntersectionObserver(
    ([e], io) => {
      if (!e.isIntersecting) return;
      ui.classList.add('is-aan');
      io.disconnect();
    },
    { threshold: 0.4 },
  ).observe(ui);
</script>

<style>
  .vg {
    padding-block: clamp(64px, 6vw, 88px);
    overflow: clip;
  }

  .vg__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .vg__kop {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .vg__kop .lead {
    max-width: 26em;
  }

  /* ---------- Vier principes ---------- */
  .vg__principes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
  }

  .vg__principes li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: start;
    gap: 4px 14px;
    padding: 20px 0;
    border-top: 1px solid var(--lijn);
  }

  .vg__nummer {
    grid-row: span 2;
    font-family: var(--font-kop);
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--hemel);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }

  .vg__principes b {
    font-family: var(--font-kop);
    font-weight: var(--kop-gewicht);
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }

  .vg__principes p {
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.68);
  }

  /* ---------- Grote Kees-bloem achter de kaart ---------- */
  .vg__rechts {
    position: relative;
    display: grid;
  }

  .vg__vorm {
    position: absolute;
    top: 58%;
    left: 72%;
    width: 150%;
    aspect-ratio: 1;
    margin: -75% 0 0 -75%;
    pointer-events: none;
  }

  .vg__vorm :global(.vg__bloem) {
    width: 100%;
    height: 100%;
    max-width: none;
    animation: draai 90s linear infinite;
  }

  /* ---------- Instellingenkaart ---------- */
  .vg-ui {
    position: relative;
    rotate: -1.5deg;
    padding: 8px;
    border-radius: var(--radius-l);
    background: var(--licht);
    color: var(--ink);
    box-shadow: 0 60px 90px -50px rgb(0 0 20 / 0.7);
  }

  .vg-ui__kop {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 14px;
  }

  .vg-ui__kop :global(.vg-ui__avatar) {
    width: 38px;
    font-size: 1.05rem;
    padding-bottom: 3px;
  }

  .vg-ui__titel {
    display: grid;
    line-height: 1.25;
  }

  .vg-ui__titel b {
    font-family: var(--font-kop);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .vg-ui__titel span {
    font-size: 0.8rem;
    color: var(--ink-stil);
  }

  .vg-ui__eu {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 5px 11px 5px 8px;
    border-radius: 999px;
    background: var(--hemel-zacht);
    color: var(--indigo);
    font-size: 0.76rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .vg-ui__eu svg {
    width: 16px;
  }

  .vg-ui__akkoord {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    padding: 12px 14px;
    border-radius: var(--radius-m);
    background: var(--wit);
    box-shadow: 0 0 0 1px var(--lijn);
  }

  .vg-ui__slot {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--nacht);
    color: var(--wit);
  }

  .vg-ui__slot svg {
    width: 17px;
  }

  .vg-ui__akkoord-tekst {
    display: grid;
    flex: 1;
    line-height: 1.3;
  }

  .vg-ui__akkoord-tekst b {
    font-size: 0.92rem;
  }

  .vg-ui__akkoord-tekst span {
    font-size: 0.78rem;
    color: var(--ink-stil);
  }

  .vg-ui__blok {
    padding: 12px 14px 14px;
    border-radius: var(--radius-m);
    background: var(--wit);
    box-shadow: 0 0 0 1px var(--lijn);
  }

  .vg-ui__blok + .vg-ui__blok {
    margin-top: 8px;
  }

  .vg-ui__label {
    margin-bottom: 6px;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-stil);
  }

  /* Tabel: wie mag wat */
  .vg-tabel {
    width: 100%;
    border-collapse: collapse;
  }

  .vg-tabel thead th {
    padding: 0 0 6px;
    font-size: 0.74rem;
    font-weight: 650;
    color: var(--ink-zacht);
    text-align: center;
    width: 76px;
  }

  .vg-tabel thead th:first-child {
    width: auto;
  }

  .vg-tabel tbody tr {
    border-top: 1px solid var(--lijn);
  }

  .vg-tabel tbody th {
    padding: 7px 0;
    text-align: left;
    font-weight: inherit;
  }

  .vg-tabel td {
    text-align: center;
  }

  .vg-tabel tr.is-gewijzigd th {
    animation: vg-flits 1.4s var(--uit);
  }

  @keyframes vg-flits {
    20% {
      background: var(--hemel-licht);
    }
  }

  .vg-persoon {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .vg-persoon__init {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-family: var(--font-kop);
    font-weight: 650;
    font-size: 0.85rem;
    box-shadow: inset 0 0 0 1px var(--lijn);
  }

  .vg-persoon__tekst {
    display: grid;
    line-height: 1.2;
    min-width: 0;
  }

  .vg-persoon__tekst b {
    font-size: 0.9rem;
  }

  .vg-persoon__tekst span {
    font-size: 0.74rem;
    color: var(--ink-stil);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Schakelaar */
  .vg-schakel {
    position: relative;
    display: inline-block;
    flex: none;
    width: 40px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--licht-diep);
    vertical-align: middle;
    cursor: pointer;
    transition: background-color 0.35s var(--uit);
  }

  .vg-schakel span {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--wit);
    box-shadow: 0 2px 5px rgb(20 20 60 / 0.2);
    transition: transform 0.45s var(--veer);
  }

  .vg-schakel[aria-checked='true'],
  .vg-schakel--vast {
    background: var(--indigo);
  }

  .vg-schakel[aria-checked='true'] span,
  .vg-schakel--vast span {
    transform: translateX(16px);
  }

  .vg-schakel:hover span {
    box-shadow: 0 2px 8px rgb(20 20 60 / 0.3);
  }

  .vg-schakel--vast {
    cursor: default;
    opacity: 0.55;
  }

  /* Budgetmeters */
  .vg-budget {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 2px 0 0;
    list-style: none;
  }

  .vg-budget li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5px 12px;
    align-items: baseline;
    font-size: 0.84rem;
  }

  .vg-budget__naam {
    font-weight: 650;
  }

  .vg-budget__bedrag {
    color: var(--ink-stil);
    font-variant-numeric: tabular-nums;
  }

  .vg-budget__bedrag b {
    color: var(--ink);
  }

  .vg-budget__balk {
    grid-column: 1 / -1;
    position: relative;
    height: 8px;
    border-radius: 999px;
    background: var(--hemel-licht);
    box-shadow: inset 0 0 0 1px var(--lijn);
    overflow: hidden;
  }

  .vg-budget__balk span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--hemel), var(--indigo));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.6s var(--uit);
    transition-delay: calc(var(--i) * 150ms + 300ms);
  }

  .is-aan .vg-budget__balk span {
    transform: scaleX(var(--p));
  }

  .vg-budget__over {
    margin-left: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--hemel-licht);
    font-size: 0.72rem;
    font-weight: 650;
    color: var(--indigo);
    font-variant-numeric: tabular-nums;
  }

  /* Melding na een wijziging */
  .vg-melding {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    padding: 8px 12px 8px 8px;
    border-radius: 12px;
    background: var(--licht);
    box-shadow: inset 0 0 0 1px var(--lijn);
    color: var(--ink-stil);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
    transition:
      background-color 0.4s,
      color 0.4s;
  }

  .vg-melding.is-gewijzigd {
    background: var(--hemel-licht);
    color: var(--ink);
  }

  .vg-melding.is-nieuw span:last-child {
    animation: vg-melding 0.6s var(--uit);
  }

  @keyframes vg-melding {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .vg-melding__icoon {
    display: grid;
    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--licht-diep);
    color: var(--wit);
    transition: background-color 0.4s;
  }

  .vg-melding.is-gewijzigd .vg-melding__icoon {
    background: var(--indigo);
  }

  .vg-melding.is-nieuw .vg-melding__icoon {
    animation: vg-pop 0.6s var(--veer);
  }

  @keyframes vg-pop {
    from {
      transform: scale(0.4);
    }
  }

  .vg-melding__icoon svg {
    width: 12px;
  }

  @media (max-width: 1000px) {
    .vg__grid {
      grid-template-columns: 1fr;
    }

    /* Groter tikvlak rond de schakelaars (minstens 44px hoog) */
    .vg-schakel::after {
      content: '';
      position: absolute;
      inset: -10px -6px;
    }

    .vg__rechts {
      width: min(100%, 560px);
    }

    .vg-ui {
      rotate: 0deg;
    }

    .vg__vorm {
      top: 90%;
      left: 86%;
      width: 100%;
      margin: -50% 0 0 -50%;
    }
  }

  @media (max-width: 520px) {
    .vg__principes {
      grid-template-columns: 1fr;
    }

    .vg__principes li {
      padding: 16px 0;
    }

    .vg-ui__kop {
      flex-wrap: wrap;
    }

    .vg-ui__eu {
      margin-left: 0;
    }

    .vg-ui__kop {
      display: grid;
      grid-template-columns: auto 1fr;
    }

    .vg-ui__eu {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .vg-ui__blok,
    .vg-ui__akkoord {
      padding-inline: 12px;
    }

    .vg-tabel thead th {
      width: 52px;
      font-size: 0.68rem;
    }

    .vg-persoon__init {
      display: none;
    }

    /* Compacter op mobiel, zodat de kaart in één scherm past */
    .vg-ui__eu,
    .vg-ui__akkoord-tekst span,
    .vg-tabel tbody tr:nth-child(4),
    .vg-budget li:nth-child(n + 2) {
      display: none;
    }

    .vg-ui__kop {
      padding-bottom: 4px;
    }
  }
</style>
