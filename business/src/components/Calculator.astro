---
import Bloem from '../../../src/components/Bloem.astro';

// CTA-rij onder de prijzen die een rekenhulp in een modal opent.
interface Pakket {
  id: string;
  naam: string;
  max: number;
  prijs: number;
  uitgelicht?: boolean;
}

const { pakketten } = Astro.props as { pakketten: Pakket[] };
const standaard = pakketten.find((p) => p.uitgelicht) ?? pakketten[0];
---

<div class="rk" data-rk>
  <div class="rk__cta" data-reveal style="--d:4">
    <p class="rk__vraag">Hoeveel uur per week ben jij eigenlijk office manager?</p>
    <button class="knop knop--klein rk__open" type="button" data-rk-open aria-haspopup="dialog">
      Reken het uit
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </div>

  <dialog class="rk__dialoog" aria-labelledby="rk-titel" data-rk-dialoog data-lenis-prevent>
    <form class="rk__paneel" method="dialog" data-rk-form onsubmit="return false">
      <div class="rk__kop">
        <h2 class="rk__titel" id="rk-titel">
          Reken het zelf uit<Bloem kleur="var(--sticker)" lobes={10} amp={0.11} class="rk__bloem" />
        </h2>
        <button class="rk__sluit" type="button" data-rk-sluit aria-label="Sluiten">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"></path></svg>
        </button>
      </div>

      <label class="rk__veld">
        <span class="rk__label">Uren per week aan kantoorzaken <b data-rk-uren-tekst>4 uur</b></span>
        <input type="range" min="1" max="16" step="1" value="4" data-rk-uren autofocus />
      </label>

      <div class="rk__rij">
        <label class="rk__veld">
          <span class="rk__label">Uurtarief</span>
          <span class="rk__invoer">
            <span aria-hidden="true">€</span>
            <input type="number" min="10" max="300" step="5" value="45" inputmode="numeric" data-rk-tarief aria-label="Uurtarief in euro" />
          </span>
        </label>
        <div class="rk__veld">
          <span class="rk__label" id="rk-team-label">Teamgrootte</span>
          <div class="rk__segment" role="radiogroup" aria-labelledby="rk-team-label">
            {
              pakketten.map((p) => (
                <label>
                  <input type="radio" name="rk-team" value={p.id} data-naam={p.naam} data-prijs={p.prijs} checked={p.id === standaard.id} />
                  <span>tot {p.max}</span>
                </label>
              ))
            }
          </div>
        </div>
      </div>

      <div class="rk__uitkomst" aria-live="polite">
        <div class="rk__balk">
          <span class="rk__balk-naam">Zelf regelen</span>
          <span class="rk__spoor"><span class="rk__vulling rk__vulling--zelf" data-rk-balk-zelf></span></span>
          <b data-rk-zelf>€780</b>
        </div>
        <div class="rk__balk">
          <span class="rk__balk-naam" data-rk-kees-naam>Kees {standaard.naam}</span>
          <span class="rk__spoor"><span class="rk__vulling rk__vulling--kees" data-rk-balk-kees></span></span>
          <b data-rk-kees>€{standaard.prijs}</b>
        </div>
        <p class="rk__zin" data-rk-zin></p>
      </div>

      <div class="rk__voet">
        <a href="#wachtlijst" class="knop knop--klein" data-rk-wachtlijst>Op de wachtlijst</a>
        <span class="rk__klein">Bedragen per maand, excl. btw</span>
      </div>
    </form>
  </dialog>
</div>

<script>
  type LenisLike = { stop(): void; start(): void; scrollTo(t: string | Element, o?: object): void };

  document.querySelectorAll<HTMLElement>('[data-rk]').forEach((root) => {
    const dlg = root.querySelector<HTMLDialogElement>('[data-rk-dialoog]')!;
    const openKnop = root.querySelector<HTMLButtonElement>('[data-rk-open]')!;
    const form = root.querySelector<HTMLFormElement>('[data-rk-form]')!;
    const lenis = () => (window as unknown as { lenis?: LenisLike }).lenis;

    // ---------- Openen en sluiten ----------
    let sluitTimer = 0;
    function open() {
      clearTimeout(sluitTimer);
      if (!dlg.open) dlg.showModal();
      lenis()?.stop();
      document.documentElement.classList.add('rk-vast');
      requestAnimationFrame(() => requestAnimationFrame(() => dlg.classList.add('is-open')));
    }

    function opruimen() {
      lenis()?.start();
      document.documentElement.classList.remove('rk-vast');
    }

    function sluit(daarna?: () => void) {
      if (!dlg.open) return;
      dlg.classList.remove('is-open');
      const klaar = () => {
        clearTimeout(sluitTimer);
        dlg.removeEventListener('transitionend', opEinde);
        if (dlg.open) dlg.close();
        daarna?.();
      };
      const opEinde = (e: TransitionEvent) => e.target === dlg && e.propertyName === 'opacity' && klaar();
      dlg.addEventListener('transitionend', opEinde);
      sluitTimer = window.setTimeout(klaar, 450);
    }

    openKnop.addEventListener('click', open);
    root.querySelector('[data-rk-sluit]')!.addEventListener('click', () => sluit());
    dlg.addEventListener('cancel', (e) => {
      e.preventDefault();
      sluit();
    });
    dlg.addEventListener('close', () => {
      dlg.classList.remove('is-open');
      opruimen();
      openKnop.focus({ preventScroll: true });
    });
    // Klik naast het paneel (op de backdrop) sluit de modal
    // (alleen als de klik ook daar begon, zodat slepen vanuit een veld niet sluit)
    let begonBuiten = false;
    dlg.addEventListener('pointerdown', (e) => {
      begonBuiten = e.target === dlg;
    });
    dlg.addEventListener('click', (e) => {
      if (begonBuiten && e.target === dlg) sluit();
      begonBuiten = false;
    });

    root.querySelector('[data-rk-wachtlijst]')!.addEventListener('click', (e) => {
      e.preventDefault();
      sluit(() => {
        const doel = document.querySelector('#wachtlijst');
        if (!doel) return;
        const l = lenis();
        if (l) l.scrollTo(doel, { offset: -40, duration: 1.4 });
        else doel.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // ---------- Rekenen ----------
    const uren = form.querySelector<HTMLInputElement>('[data-rk-uren]')!;
    const urenTekst = form.querySelector<HTMLElement>('[data-rk-uren-tekst]')!;
    const tarief = form.querySelector<HTMLInputElement>('[data-rk-tarief]')!;
    const zelfEl = form.querySelector<HTMLElement>('[data-rk-zelf]')!;
    const keesEl = form.querySelector<HTMLElement>('[data-rk-kees]')!;
    const keesNaam = form.querySelector<HTMLElement>('[data-rk-kees-naam]')!;
    const balkZelf = form.querySelector<HTMLElement>('[data-rk-balk-zelf]')!;
    const balkKees = form.querySelector<HTMLElement>('[data-rk-balk-kees]')!;
    const zin = form.querySelector<HTMLElement>('[data-rk-zin]')!;
    const WEKEN_PER_MAAND = 52 / 12;
    const euro = (n: number) => `€${Math.round(n).toLocaleString('nl-NL')}`;

    function reken() {
      const u = Number(uren.value);
      const t = Math.min(300, Math.max(10, Number(tarief.value) || 45));
      const team = form.querySelector<HTMLInputElement>('input[name="rk-team"]:checked')!;
      const naam = team.dataset.naam!;
      const kees = Number(team.dataset.prijs);
      const zelf = u * t * WEKEN_PER_MAAND;

      uren.style.setProperty('--p', `${((u - 1) / 15) * 100}%`);
      urenTekst.textContent = `${u} uur`;
      zelfEl.textContent = euro(zelf);
      keesEl.textContent = euro(kees);
      keesNaam.textContent = `Kees ${naam}`;

      const max = Math.max(zelf, kees);
      balkZelf.style.setProperty('--w', `${(zelf / max) * 100}%`);
      balkKees.style.setProperty('--w', `${(kees / max) * 100}%`);

      if (zelf > kees) {
        zin.innerHTML = `Met Kees ${naam} houden jullie <b class="rk__winst">${euro(zelf - kees)}</b> per maand over. Dat is ${euro((zelf - kees) * 12)} per jaar.`;
      } else {
        const grens = Math.ceil((kees / (t * WEKEN_PER_MAAND)) * 2) / 2;
        zin.innerHTML = `Kees ${naam} is voordeliger vanaf <b>${grens.toLocaleString('nl-NL')} uur</b> per week.`;
      }
    }

    form.addEventListener('input', reken);
    tarief.addEventListener('blur', () => {
      tarief.value = String(Math.min(300, Math.max(10, Number(tarief.value) || 45)));
      reken();
    });
    reken();
  });
</script>

<style>
  /* ---------- CTA-rij op de pagina: nachtblauw met een draaiende bloem ---------- */
  .rk__cta {
    display: flex;
    align-items: center;
    gap: 18px;
    width: fit-content;
    max-width: 100%;
    margin: 22px auto 0;
    padding: 12px 12px 12px 30px;
    border-radius: 999px;
    background: var(--nacht);
    color: var(--wit);
    box-shadow: 0 30px 50px -36px rgb(20 20 60 / 0.7);
  }

  .rk__icoon {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    color: var(--nacht);
  }

  .rk__icoon :global(.rk__icoon-bloem) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    animation: draai 14s linear infinite;
  }

  .rk__icoon-klok {
    position: relative;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rk__cta:hover :global(.rk__icoon-bloem) {
    animation-duration: 3s;
  }

  .rk__vraag {
    flex: 1;
    font-family: var(--font-kop);
    font-weight: var(--kop-gewicht);
    letter-spacing: -0.025em;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .rk__open {
    flex: none;
    --knop-bg: var(--wit);
    --knop-fg: var(--nacht);
    --knop-schaduw: var(--hemel);
  }

  /* ---------- Dialoog ---------- */
  :global(html.rk-vast) {
    overflow: hidden;
  }

  .rk__dialoog {
    width: min(540px, 100% - 32px);
    max-width: none;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-l);
    background: var(--wit);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--lijn),
      0 40px 80px -30px rgb(20 20 60 / 0.45);
    overflow: auto;
    overscroll-behavior: contain;
    opacity: 0;
    translate: 0 18px;
    scale: 0.97;
    transition:
      opacity 0.35s var(--uit),
      translate 0.5s var(--uit),
      scale 0.5s var(--uit);
  }

  .rk__dialoog.is-open {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  .rk__dialoog::backdrop {
    background: rgb(20 20 60 / 0.42);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 0.35s var(--uit);
  }

  .rk__dialoog.is-open::backdrop {
    opacity: 1;
  }

  .rk__paneel {
    display: grid;
    gap: 22px;
    padding: 26px 28px 28px;
  }

  .rk__kop {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .rk__titel {
    display: flex;
    align-items: baseline;
    font-size: 1.6rem;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .rk__titel :global(.rk__bloem) {
    flex: none;
    max-width: none;
    width: 0.3em;
    margin-left: 0.08em;
    animation: draai 30s linear infinite;
  }

  .rk__sluit {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    margin: -4px -6px 0 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--hemel-licht);
    cursor: pointer;
    transition:
      background-color 0.3s var(--uit),
      rotate 0.5s var(--veer);
  }

  .rk__sluit:hover {
    background: var(--hemel-zacht);
    rotate: 90deg;
  }

  .rk__sluit svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--nacht);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .rk__veld {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .rk__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--ink-zacht);
  }

  .rk__label b {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--nacht);
    font-variant-numeric: tabular-nums;
  }

  .rk__rij {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
  }

  /* Slider */
  .rk input[type='range'] {
    --p: 20%;
    width: 100%;
    height: 28px;
    margin: 0;
    background: none;
    appearance: none;
    cursor: pointer;
  }

  .rk input[type='range']::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--primair) var(--p), var(--hemel-zacht) var(--p));
  }

  .rk input[type='range']::-moz-range-track {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--primair) var(--p), var(--hemel-zacht) var(--p));
  }

  .rk input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 24px;
    height: 24px;
    margin-top: -8px;
    border-radius: 50%;
    background: var(--wit);
    box-shadow:
      0 0 0 2px var(--nacht),
      0 3px 0 var(--nacht);
    transition: scale 0.3s var(--veer);
  }

  .rk input[type='range']::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border: 2px solid var(--nacht);
    border-radius: 50%;
    background: var(--wit);
  }

  .rk input[type='range']:active::-webkit-slider-thumb {
    scale: 1.15;
  }

  .rk__invoer {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 44px;
    padding: 0 14px;
    border-radius: var(--radius-s);
    background: var(--hemel-licht);
    box-shadow: inset 0 0 0 1px var(--lijn);
    font-weight: 600;
  }

  .rk__invoer:focus-within {
    box-shadow: inset 0 0 0 1.5px var(--primair);
  }

  .rk__invoer input {
    width: 100%;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--nacht);
    font: inherit;
    outline: none;
    -moz-appearance: textfield;
  }

  .rk__invoer input::-webkit-inner-spin-button,
  .rk__invoer input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }

  .rk__segment {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 44px;
    padding: 4px;
    border-radius: var(--radius-s);
    background: var(--hemel-licht);
    box-shadow: inset 0 0 0 1px var(--lijn);
  }

  .rk__segment label {
    position: relative;
    display: grid;
  }

  .rk__segment input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .rk__segment span {
    display: grid;
    place-items: center;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink-zacht);
    cursor: pointer;
    transition:
      background-color 0.3s var(--uit),
      color 0.3s;
  }

  .rk__segment input:checked + span {
    background: var(--wit);
    color: var(--nacht);
    box-shadow: 0 1px 3px rgb(20 20 60 / 0.18);
  }

  .rk__segment input:focus-visible + span {
    outline: 2px solid var(--indigo);
  }

  /* Uitkomst */
  .rk__uitkomst {
    display: grid;
    gap: 10px;
    padding: 18px 20px;
    border-radius: var(--radius-m);
    background: var(--hemel-licht);
  }

  .rk__balk {
    display: grid;
    grid-template-columns: 104px 1fr 56px;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
  }

  .rk__balk-naam {
    color: var(--ink-zacht);
    white-space: nowrap;
  }

  .rk__balk b {
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .rk__spoor {
    height: 10px;
    border-radius: 999px;
    background: var(--wit);
    overflow: hidden;
  }

  .rk__vulling {
    display: block;
    height: 100%;
    width: var(--w, 0%);
    border-radius: inherit;
    transition: width 0.8s var(--uit);
  }

  .rk__vulling--zelf {
    background: repeating-linear-gradient(-45deg, var(--hemel) 0 6px, var(--hemel-zacht) 6px 12px);
  }

  .rk__vulling--kees {
    background: var(--primair);
  }

  .rk__zin {
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--lijn);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-zacht);
  }

  .rk__zin :global(b) {
    color: var(--nacht);
    font-weight: 700;
  }

  .rk__zin :global(.rk__winst) {
    padding: 0 6px;
    border-radius: 6px;
    background: var(--boter);
  }

  .rk__voet {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }

  .rk__klein {
    font-size: 0.8rem;
    color: var(--ink-stil);
  }

  @media (max-width: 760px) {
    .rk__cta {
      flex-wrap: wrap;
      gap: 14px;
      border-radius: var(--radius-l);
      padding: 18px 18px 20px;
    }

    .rk__icoon {
      width: 48px;
      height: 48px;
    }

    .rk__vraag {
      flex-basis: calc(100% - 64px);
      font-size: 1.15rem;
    }

    .rk__open {
      width: 100%;
    }
  }

  /* Mobiel: de modal schuift als een sheet van onderen in beeld */
  @media (max-width: 560px) {
    .rk__dialoog {
      width: 100%;
      max-height: calc(100dvh - 24px);
      margin: auto 0 0;
      border-radius: var(--radius-l) var(--radius-l) 0 0;
      translate: 0 100%;
      scale: 1;
      transition:
        opacity 0.25s var(--uit),
        translate 0.55s var(--uit);
    }

    .rk__paneel {
      gap: 18px;
      padding: 22px 20px calc(24px + env(safe-area-inset-bottom));
    }

    .rk__titel {
      font-size: 1.35rem;
    }

    .rk__rij {
      grid-template-columns: 96px 1fr;
      gap: 12px;
    }

    .rk__balk {
      grid-template-columns: 88px 1fr 50px;
      gap: 8px;
    }

    .rk__voet .knop {
      width: 100%;
    }

    .rk__sluit {
      width: 44px;
      height: 44px;
    }

    /* Minstens 16px, anders zoomt iOS in bij het tikken in het veld */
    .rk__invoer input {
      font-size: max(1rem, 16px);
    }
  }
</style>
