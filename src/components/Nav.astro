---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import BusinessLogo from './BusinessLogo.astro';
import { BUSINESS_URL, BUSINESS_LOGO } from '../lib/sites';
import stelFoto from '../assets/stel-keuken.jpg';

// Links in het mobiele uitklapmenu
const mobielLinks = [
  { href: '/#een-dag', label: 'Hoe het werkt' },
  { href: '/#functies', label: 'Functies' },
  { href: '/#veiligheid', label: 'Veiligheid' },
  { href: '/#vragen', label: 'Vragen' },
];

const functies = [
  { href: '/#functies', label: 'Gezinsagenda' },
  { href: '/#functies', label: 'Ochtendbericht' },
  { href: '/#functies', label: 'Weekmenu en boodschappen' },
  { href: '/#functies', label: 'Herinneringen met een plan' },
  { href: '/#functies', label: 'Tieners appen zelf' },
  { href: '/#functies', label: 'Twee huizen' },
];
---

<header class="nav" data-nav>
  <div class="nav__pil">
    <a href="/" class="nav__logo" aria-label="Kees, naar de homepage">
      <Logo />
    </a>

    <nav aria-label="Hoofdmenu" class="nav__menu">
      <ul class="nav__links" data-nav-links>
        <li><a class="nav__link" href="/#een-dag"><span class="rol"><span>Hoe het werkt</span></span></a></li>
        <li class="nav__heeft-menu">
          <button class="nav__link" aria-expanded="false" aria-controls="menu-functies" data-menu-knop>
            <span class="rol"><span>Functies</span></span>
          </button>
          <div class="mega" id="menu-functies" data-mega>
            <div class="mega__lijst">
              <p class="mega__label">Functies</p>
              <ul>
                {functies.map((f) => <li><a href={f.href}>{f.label}</a></li>)}
              </ul>
            </div>
            <a class="mega__kaart" href="/#aanmelden">
              <Image src={stelFoto} alt="" widths={[300, 560]} sizes="280px" class="mega__foto" />
              <span class="mega__tekst">
                <b>Word een founding family</b>
                <span>Bij 1.000 gezinnen gaan we van start.</span>
                <span class="mega__knop">Aanmelden</span>
              </span>
            </a>
          </div>
        </li>
        <li><a class="nav__link" href="/#veiligheid"><span class="rol"><span>Veiligheid</span></span></a></li>
        <li><a class="nav__link" href="/#vragen"><span class="rol"><span>Vragen</span></span></a></li>
      </ul>
    </nav>

    <a href="/#aanmelden" class="nav__cta">
      <span class="rol"><span>Aanmelden</span></span>
    </a>

    <button
      class="nav__menuknop"
      aria-expanded="false"
      aria-controls="menu-mobiel"
      aria-label="Menu openen"
      data-mobiel-knop
    >
      <span class="nav__streep" aria-hidden="true"></span>
      <span class="nav__streep" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Uitklapmenu op mobiel -->
  <div class="mobiel" id="menu-mobiel" data-mobiel>
    <nav aria-label="Menu">
      <ul class="mobiel__links">
        {
          mobielLinks.map((l, i) => (
            <li style={`--n:${i}`}>
              <a href={l.href} data-mobiel-link>
                {l.label}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={BUSINESS_URL} class="mobiel__business" style={`--n:${mobielLinks.length}`} aria-label="Business Kees: Kees voor kantoren">
      <BusinessLogo variant="regel" kleur="var(--indigo-diep)" />
      <span class="mobiel__business-label">Voor kantoren</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"></path></svg>
    </a>
  </div>
  <a href={BUSINESS_URL} class="nav__business" aria-label="Business Kees: Kees voor kantoren">
    <BusinessLogo variant={BUSINESS_LOGO} kleur="var(--indigo-diep)" />
  </a>
  <div class="nav__dimmer" data-dimmer aria-hidden="true"></div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const knop = nav.querySelector<HTMLButtonElement>('[data-menu-knop]')!;
  const item = knop.parentElement!;
  let sluitTimer: number | undefined;

  const update = () => nav.classList.toggle('is-gescrold', window.scrollY > 12);
  update();
  window.addEventListener('scroll', update, { passive: true });

  function open(waarde: boolean) {
    window.clearTimeout(sluitTimer);
    nav.classList.toggle('menu-open', waarde);
    knop.setAttribute('aria-expanded', String(waarde));
  }

  knop.addEventListener('click', () => open(knop.getAttribute('aria-expanded') !== 'true'));
  if (matchMedia('(hover: hover)').matches) {
    item.addEventListener('pointerenter', () => open(true));
    item.addEventListener('pointerleave', () => (sluitTimer = window.setTimeout(() => open(false), 160)));
  }
  // ---------- Mobiel uitklapmenu ----------
  const mobielKnop = nav.querySelector<HTMLButtonElement>('[data-mobiel-knop]')!;
  const lenis = () => (window as unknown as { lenis?: { stop(): void; start(): void } }).lenis;

  function mobiel(waarde: boolean) {
    nav.classList.toggle('mobiel-open', waarde);
    mobielKnop.setAttribute('aria-expanded', String(waarde));
    mobielKnop.setAttribute('aria-label', waarde ? 'Menu sluiten' : 'Menu openen');
    document.documentElement.classList.toggle('nav-mobiel-open', waarde);
    if (waarde) lenis()?.stop();
    else lenis()?.start();
  }

  mobielKnop.addEventListener('click', () => mobiel(!nav.classList.contains('mobiel-open')));
  nav.querySelectorAll('[data-mobiel-link]').forEach((a) => a.addEventListener('click', () => mobiel(false)));
  // Groter scherm? Dan hoort het mobiele menu dicht.
  matchMedia('(min-width: 861px)').addEventListener('change', (e) => e.matches && mobiel(false));

  nav.querySelector('[data-dimmer]')!.addEventListener('click', () => {
    open(false);
    mobiel(false);
  });
  nav.querySelectorAll('.mega a').forEach((a) => a.addEventListener('click', () => open(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    open(false);
    if (nav.classList.contains('mobiel-open')) {
      mobiel(false);
      mobielKnop.focus();
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 14px var(--gutter) 0;
    pointer-events: none;
  }

  .nav__pil {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 7px 7px 20px;
    border-radius: 999px;
    background: var(--wit);
    box-shadow:
      0 0 0 1px var(--lijn),
      0 10px 30px -18px rgb(40 10 10 / 0.35);
    pointer-events: auto;
    transition: box-shadow 0.3s;
  }

  .is-gescrold .nav__pil {
    box-shadow:
      0 0 0 1px var(--lijn),
      0 18px 40px -16px rgb(40 10 10 / 0.35);
  }

  .nav__logo {
    margin-right: 14px;
    text-decoration: none;
  }

  .nav__logo :global(.logo) {
    font-size: 1.75rem;
  }

  .nav__links {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link,
  .nav__cta {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--bordeaux);
    font-family: var(--font-tekst);
    font-weight: 750;
    font-size: 0.76rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.25s var(--zacht),
      color 0.25s var(--zacht);
  }

  .nav__link:hover,
  .menu-open .nav__heeft-menu > .nav__link {
    background: var(--bordeaux);
    color: var(--wit);
  }

  .nav__cta {
    margin-left: 6px;
    background: var(--primair);
    color: var(--op-primair);
  }

  .nav__cta:hover {
    background: var(--bordeaux);
    color: var(--wit);
  }

  /* Losse knop rechtsboven naar Business Kees */
  .nav__business {
    position: absolute;
    top: 14px;
    right: var(--gutter);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    height: 54px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--wit);
    box-shadow:
      0 0 0 1px var(--lijn),
      0 10px 30px -18px rgb(40 10 10 / 0.35);
    text-decoration: none;
    pointer-events: auto;
    transition:
      transform 0.5s var(--uit),
      box-shadow 0.5s var(--uit);
  }

  .nav__business:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px var(--lijn),
      0 18px 36px -16px rgb(40 10 10 / 0.4);
  }

  .nav__business :global(.blogo) {
    font-size: 1.6rem;
  }

  /* Rollende tekst bij hover */
  .rol {
    display: inline-block;
    height: 1.3em;
    overflow: hidden;
    line-height: 1.3;
  }

  .rol > span {
    display: inline-block;
    text-shadow: 0 1.3em currentColor;
    transition: transform 0.45s var(--zacht);
  }

  .nav__link:hover .rol > span,
  .nav__cta:hover .rol > span,
  .menu-open .nav__heeft-menu > .nav__link .rol > span {
    transform: translateY(-1.3em);
  }

  /* ---------- Mega-menu ---------- */
  .nav__heeft-menu {
    position: relative;
  }

  .mega {
    position: absolute;
    top: calc(100% + 22px);
    left: 50%;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 10px;
    width: 620px;
    padding: 10px 10px 10px 26px;
    border-radius: 28px;
    background: var(--wit);
    box-shadow: 0 30px 60px -25px rgb(40 10 10 / 0.4);
    opacity: 0;
    visibility: hidden;
    transform: translate(-42%, -8px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 0.25s var(--zacht),
      transform 0.35s var(--zacht),
      visibility 0s 0.35s;
  }

  .mega::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -24px;
    height: 24px;
  }

  .menu-open .mega {
    opacity: 1;
    visibility: visible;
    transform: translate(-42%, 0) scale(1);
    transition-delay: 0s;
  }

  .mega__lijst {
    padding-block: 16px;
  }

  .mega__label {
    margin-bottom: 14px;
    font-weight: 750;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-zacht);
  }

  .mega ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega__lijst a {
    display: inline-block;
    padding: 4px 0;
    font-family: var(--font-kop);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition:
      transform 0.3s var(--zacht),
      color 0.2s;
  }

  .mega__lijst a:hover {
    color: var(--primair-tekst);
    transform: translateX(6px);
  }

  .mega__kaart {
    position: relative;
    display: block;
    min-height: 300px;
    border-radius: 20px;
    overflow: hidden;
    color: var(--wit);
    text-decoration: none;
  }

  .mega__kaart :global(.mega__foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--zacht);
  }

  .mega__kaart:hover :global(.mega__foto) {
    transform: scale(1.05);
  }

  .mega__kaart::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgb(50 0 5 / 0.82));
  }

  .mega__tekst {
    position: absolute;
    z-index: 1;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: grid;
    gap: 4px;
    justify-items: start;
    font-size: 0.9rem;
  }

  .mega__tekst b {
    font-family: var(--font-kop);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .mega__knop {
    margin-top: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.2);
    backdrop-filter: blur(8px);
    font-weight: 750;
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .nav__dimmer {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgb(30 20 20 / 0.28), rgb(30 20 20 / 0.08));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .menu-open .nav__dimmer,
  .mobiel-open .nav__dimmer {
    opacity: 1;
    pointer-events: auto;
  }

  :global(html.nav-mobiel-open) {
    overflow: hidden;
  }

  /* ---------- Menuknop en uitklapmenu (alleen mobiel) ---------- */
  .nav__menuknop,
  .mobiel {
    display: none;
  }

  @media (max-width: 1260px) {
    .nav__business {
      position: relative;
      top: auto;
      right: auto;
      margin-left: 8px;
    }
  }

  @media (max-width: 860px) {
    .nav__business {
      display: none;
    }

    .nav__menu {
      display: none;
    }

    .nav {
      padding-top: 12px;
    }

    .nav__pil {
      width: 100%;
      gap: 4px;
      padding: 6px 6px 6px 18px;
    }

    .nav__logo {
      margin-right: auto;
    }

    .nav__logo :global(.logo) {
      font-size: 1.6rem;
    }

    .nav__cta {
      height: 44px;
      margin-left: 0;
      padding: 0 18px;
    }

    /* Menuknop: twee strepen die een kruisje worden */
    .nav__menuknop {
      position: relative;
      display: grid;
      place-items: center;
      flex: none;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--achtergrond);
      color: var(--bordeaux);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: background-color 0.3s var(--uit);
    }

    .nav__streep {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 18px;
      height: 2px;
      margin: -1px 0 0 -9px;
      border-radius: 2px;
      background: currentColor;
      translate: 0 -3.5px;
      transition:
        translate 0.4s var(--uit),
        rotate 0.4s var(--uit);
    }

    .nav__streep + .nav__streep {
      translate: 0 3.5px;
    }

    .mobiel-open .nav__menuknop {
      background: var(--bordeaux);
      color: var(--wit);
    }

    .mobiel-open .nav__streep {
      translate: 0 0;
      rotate: 45deg;
    }

    .mobiel-open .nav__streep + .nav__streep {
      rotate: -45deg;
    }

    /* Uitklapmenu: een witte kaart onder de pil */
    .mobiel {
      position: absolute;
      z-index: 2;
      top: calc(100% + 8px);
      left: var(--gutter);
      right: var(--gutter);
      display: grid;
      gap: 4px;
      max-height: calc(100svh - 100px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 8px 8px 8px;
      border-radius: 28px;
      background: var(--wit);
      box-shadow:
        0 0 0 1px var(--lijn),
        0 30px 60px -25px rgb(40 10 10 / 0.45);
      pointer-events: auto;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px) scale(0.98);
      transform-origin: top center;
      transition:
        opacity 0.25s var(--uit),
        transform 0.4s var(--uit),
        visibility 0s 0.4s;
    }

    .mobiel-open .mobiel {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .mobiel__links {
      margin: 0;
      padding: 0 12px;
      list-style: none;
    }

    .mobiel__links li + li {
      border-top: 1px solid var(--lijn);
    }

    .mobiel__links a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 58px;
      font-family: var(--font-kop);
      font-weight: var(--kop-gewicht);
      font-variation-settings: var(--kop-variatie);
      font-size: 1.55rem;
      letter-spacing: -0.03em;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }

    .mobiel__links svg {
      width: 20px;
      height: 20px;
      color: var(--primair-tekst);
    }

    .mobiel__links a:active {
      color: var(--primair-tekst);
    }

    /* Link naar Business Kees */
    .mobiel__business {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 64px;
      padding: 0 18px;
      border-radius: 20px;
      background: var(--indigo-zacht);
      color: var(--indigo-diep);
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }

    .mobiel__business :global(.blogo) {
      font-size: 1.45rem;
    }

    .mobiel__business-label {
      margin-left: auto;
      font-weight: 700;
      font-size: 0.9rem;
      opacity: 0.75;
    }

    .mobiel__business svg {
      flex: none;
      width: 18px;
      height: 18px;
    }

    /* Inhoud schuift één voor één binnen */
    .mobiel__links li,
    .mobiel__business {
      opacity: 0;
      translate: 0 8px;
      transition:
        opacity 0.3s var(--uit),
        translate 0.5s var(--uit);
    }

    .mobiel-open .mobiel__links li,
    .mobiel-open .mobiel__business {
      opacity: 1;
      translate: 0 0;
      transition-delay: calc(var(--n) * 35ms + 60ms);
    }
  }

  @media (max-width: 359px) {
    .nav__cta {
      padding: 0 14px;
    }
  }
</style>
