---
const vragen = [
  {
    v: 'Moet ik een app downloaden?',
    a: 'Nee. Kees zit gewoon in WhatsApp, de app die je toch al elke dag gebruikt. Geen nieuw account en geen nieuw wachtwoord.',
  },
  {
    v: 'Doet Kees dingen zonder dat ik het weet?',
    a: 'Nee. Kees doet een voorstel en wacht op jouw akkoord. Pas daarna gebeurt er iets.',
  },
  {
    v: 'Waar blijven onze gegevens?',
    a: 'Jullie gegevens blijven in Europa en worden nooit verkocht. En met één knop zet je alles stil.',
  },
  {
    v: 'Kunnen mijn partner en kinderen ook meedoen?',
    a: 'Ja. Iedereen in het gezin kan Kees appen. Tieners geven zelf door dat ze niet thuis eten of later thuis zijn.',
  },
  {
    v: 'Werkt Kees ook als we in twee huizen wonen?',
    a: 'Zeker. Kees is ook gemaakt voor samengestelde gezinnen en houdt bij wie wanneer waar is.',
  },
  {
    v: 'Wat kost Kees?',
    a: 'Daar zijn we nog mee bezig. Founding families horen het als eerste, ruim voordat we van start gaan.',
  },
  {
    v: 'Wanneer kan ik beginnen?',
    a: 'Zodra er 1.000 gezinnen op de lijst staan. Hoe sneller die vol is, hoe eerder Kees aan de slag gaat. Je kunt dus best een vriendin tippen.',
  },
  {
    v: 'Is Kees een hij of een zij?',
    a: 'Dat mag je zelf bepalen. Bij ons heet Kees gewoon Kees.',
  },
];
---

<section class="sectie vragen" id="vragen">
  <div class="container vragen__grid">
    <div class="sectie-kop" data-reveal>
      <h2 class="kop-l">Veelgestelde vragen</h2>
      <p class="lead">Staat je vraag er niet bij? Mail ons gerust. We zijn ook maar een gezin met een volle agenda.</p>
    </div>

    <div class="accordeon">
      {
        vragen.map((q, i) => (
          <details class="vraag-item" data-reveal style={`--d:${i % 4}`} name="faq">
            <summary>
              {q.v}
              <span class="plus" aria-hidden="true" />
            </summary>
            <div class="vraag-item__antwoord">
              <p>{q.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vragen__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .vragen .sectie-kop {
    position: sticky;
    top: 100px;
  }

  .accordeon {
    display: grid;
    gap: 8px;
  }

  .vraag-item {
    border-radius: var(--radius-m);
    background: var(--wit);
    box-shadow: inset 0 0 0 2px var(--lijn);
    transition: background-color 0.3s;
  }

  .vraag-item[open] {
    background: var(--boter-zacht);
    box-shadow: none;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 15px 18px 15px 22px;
    font-weight: 750;
    font-size: 1.02rem;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .plus {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--indigo);
    transition:
      rotate 0.45s var(--veer),
      background-color 0.3s;
  }

  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2.5px;
    margin: -1.25px 0 0 -6px;
    border-radius: 2px;
    background: var(--wit);
  }

  .plus::after {
    rotate: 90deg;
  }

  .vraag-item[open] .plus {
    rotate: 135deg;
    background: var(--bordeaux);
  }

  .vraag-item__antwoord {
    padding: 0 22px 18px;
    color: var(--ink-zacht);
    font-size: 0.98rem;
  }

  .vraag-item[open] .vraag-item__antwoord {
    animation: open 0.4s var(--zacht);
  }

  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 860px) {
    .vragen {
      padding-block: 56px 64px;
    }

    .vragen__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .vragen .sectie-kop {
      position: static;
      gap: 12px;
      margin-bottom: 0;
    }

    summary {
      min-height: 60px;
      padding: 14px 14px 14px 18px;
    }

    .vraag-item__antwoord {
      padding: 0 18px 18px;
      font-size: 1rem;
    }
  }
</style>
